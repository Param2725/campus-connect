    {
      "name": "3. Order Service (:3003) & Inter-Service Calls",
      "item": [
        {
          "name": "Order Service Health Check",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{order_service_url}}/health",
              "host": ["{{order_service_url}}"],
              "path": ["health"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Dependencies verified in health response\", function () {",
                  "    const jsonData = pm.response.json();",
                  "    pm.expect(jsonData.dependencies).to.have.property(\"userServiceUrl\");",
                  "    pm.expect(jsonData.dependencies).to.have.property(\"productServiceUrl\");",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "POST Create Order (Valid Order -> User & Product Communication)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"userId\": \"101\",\n  \"productId\": \"501\",\n  \"quantity\": 2\n}"
            },
            "url": {
              "raw": "{{order_service_url}}/orders",
              "host": ["{{order_service_url}}"],
              "path": ["orders"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 201 Created\", function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "pm.test(\"Inter-service user & product data snapshots embedded\", function () {",
                  "    const jsonData = pm.response.json();",
                  "    pm.expect(jsonData.success).to.eql(true);",
                  "    pm.expect(jsonData.data.userId).to.eql(\"101\");",
                  "    pm.expect(jsonData.data.productId).to.eql(\"501\");",
                  "    pm.expect(jsonData.data.user.name).to.eql(\"Aarav Patel\");",
                  "    pm.expect(jsonData.data.product.name).to.include(\"Distributed Systems\");",
                  "    pm.expect(jsonData.data.totalPrice).to.be.above(0);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "GET All Orders",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{order_service_url}}/orders",
              "host": ["{{order_service_url}}"],
              "path": ["orders"]
            }
