              }
            }
          ]
        },
        {
          "name": "POST Order Negative Test (Invalid User ID -> 404 Not Found)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"userId\": \"9999\",\n  \"productId\": \"501\",\n  \"quantity\": 1\n}"
            },
            "url": {
              "raw": "{{order_service_url}}/orders",
              "host": ["{{order_service_url}}"],
              "path": ["orders"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 404 Not Found\", function () {",
                  "    pm.response.to.have.status(404);",
                  "});",
                  "pm.test(\"Error message indicates user does not exist\", function () {",
                  "    const jsonData = pm.response.json();",
                  "    pm.expect(jsonData.error).to.include(\"User\");",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "POST Order Negative Test (Invalid Product ID -> 404 Not Found)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"userId\": \"101\",\n  \"productId\": \"9999\",\n  \"quantity\": 1\n}"
            },
            "url": {
              "raw": "{{order_service_url}}/orders",
              "host": ["{{order_service_url}}"],
              "path": ["orders"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 404 Not Found\", function () {",
                  "    pm.response.to.have.status(404);",
                  "});",
                  "pm.test(\"Error message indicates product does not exist\", function () {",
                  "    const jsonData = pm.response.json();",
                  "    pm.expect(jsonData.error).to.include(\"Product\");",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "POST Order Resilience Test (User Service Unavailable -> 503)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"userId\": \"101\",\n  \"productId\": \"501\",\n  \"quantity\": 1\n}"
            },
            "url": {
              "raw": "{{order_service_url}}/orders",
              "host": ["{{order_service_url}}"],
              "path": ["orders"]
            },
            "description": "Execute this test after stopping user-service (e.g. docker stop user-service). Expected result: Controlled HTTP 503 Service Unavailable."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 503 Service Unavailable when dependency is down\", function () {",
                  "    pm.response.to.have.status(503);",
                  "});",
                  "pm.test(\"Error specifies user-service dependency failure\", function () {",
                  "    const jsonData = pm.response.json();",
                  "    pm.expect(jsonData.service).to.eql(\"user-service\");",
                  "    pm.expect(jsonData.status).to.eql(503);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "POST Order Recovery Test (After Restarting User Service -> 201)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"userId\": \"102\",\n  \"productId\": \"502\",\n  \"quantity\": 1\n}"
            },
            "url": {
              "raw": "{{order_service_url}}/orders",
              "host": ["{{order_service_url}}"],
              "path": ["orders"]
            },
            "description": "Execute this test after restarting user-service (e.g. docker start user-service). Expected result: HTTP 201 Created recovery."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 201 Created on service recovery\", function () {",
                  "    pm.response.to.have.status(201);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        }
