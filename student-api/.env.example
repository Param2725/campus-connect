# Environment Variables for Student REST API (Lab 4 & Lab 5 Docker)
PORT=3000

# Docker Multi-Container Network / Docker Compose Configuration
# Note: Use container/service name 'mongodb' instead of 'localhost'
MONGO_URI=mongodb://mongodb:27017/campusconnect
MONGODB_URI=mongodb://mongodb:27017/campusconnect

# Local Development (Standalone Host Machine without Docker)
# MONGO_URI=mongodb://127.0.0.1:27017/campusconnect

# MongoDB Atlas Cloud Database (Optional)
# MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/campusconnect?retryWrites=true&w=majority
